#!/usr/bin/env bash

STATIONS_FILE="$HOME/.scriptfiles/train_stations.txt"

hour="${1:-}"
if [[ -n "$hour" && ! "$hour" =~ ^([01]?[0-9]|2[0-3]):[0-5][0-9]$ ]]; then
  echo "error: invalid hour '$hour', expected HH:MM" >&2
  exit 1
fi

if [[ ! -f "$STATIONS_FILE" ]]; then
  echo "error: $STATIONS_FILE not found"
  exit 1
fi

select_station() {
  local prompt="$1"
  fzf --height=~40% --prompt "$prompt" --layout=reverse < "$STATIONS_FILE"
}

start=$(select_station "Start >> ")
[[ -z "$start" ]] && exit 0

end=$(select_station "End >> ")
[[ -z "$end" ]] && exit 0

url="https://koleo.pl/rozklad-pkp/$start/$end"
[[ -n "$hour" ]] && url+="/$(printf '%(%d-%m-%Y)T' -1)_$hour"

focus_or_open_firefox_sway "$url"
