# Read `man 5 sway` for a complete reference.

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
# set $term foot
set $term alacritty msg create-window
set $menu fuzzel -I -l 5 | xargs swaymsg exec
set $term2 DONT_SAVE_PATH=true alacritty msg create-window --class AlacrittyFloating

include /etc/sway/config.d/*

exec alacritty --daemon

exec mako

exec swayidle -w \
    timeout 300 'swaylock -f -c 000000' \
    before-sleep 'swaylock -f -c 000000 -e -i ~/.wallpapers/geo_pattern_even_darker.png'

include ~/.config/sway/config.d/*
include ~/.config/sway/themes/white
