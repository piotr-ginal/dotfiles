[core]
	editor = hx
	pager = delta
	compression = 9
	whitespace = error
	autocrlf = input
	safecrlf = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default
	context = 3

[init]
	defaultBranch = main

[advice]
	addEmptyPathspec = false
	pushNonFastForward = false
	statusHints = false

[status]
	showStash = true

[url "git@github.com:"]
	insteadOf = "gh:"

[url "git@github.com:piotr-ginal/"]
	insteadOf = "pg:"

[url "git@codeberg.org:"]
	insteadOf = "cb:"

[color "diff"]
	commit = cyan

[rebase]
	autoStash = true

# see git-log.1 `^PRETTY FORMATS$`
[log]
	date = format:%a %d.%m.%Y %z

[pretty]
	concise = "%C(auto)%H%d%n%an <%ae> %ad %G?%n%n%w(0,4,4)%B"

[format]
	pretty = "concise"
